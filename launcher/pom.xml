<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
          https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fadeout.software.wasdi</groupId>
        <artifactId>wasdi-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>launcher</artifactId>
    <name>launcher</name>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <revision>1.0</revision>
        <sVersionAssertjCore>3.27.7</sVersionAssertjCore>
        <sVersionBcpkixJdk15on>1.84</sVersionBcpkixJdk15on>
        <sVersionCommonsCli>1.10.0</sVersionCommonsCli>
        <sVersionFlattenMavenPlugin>1.5.0</sVersionFlattenMavenPlugin>
        <sVersionJson>20251224</sVersionJson>
        <sVersionJunit>4.13.1</sVersionJunit>
        <sVersionJUniversalChardet>2.5.0</sVersionJUniversalChardet>
        <sVersionMavenJarPlugin>3.3.0</sVersionMavenJarPlugin>
        <sVersionMavenShadePlugin>3.5.0</sVersionMavenShadePlugin>
        <sVersionNetcdfAll>5.5.2</sVersionNetcdfAll>
        <sVersionOkHttp>5.5.0</sVersionOkHttp>
        <sVersionMicrowavetbx>14.0.0</sVersionMicrowavetbx>
        <sVersionOpticaltbx>14.0.0</sVersionOpticaltbx>
        <sVersionSnap>14.0.0</sVersionSnap>
        <sVersionSMOSTbx>14.0.0</sVersionSMOSTbx>
        <sVersionSshj>0.40.0</sVersionSshj>
        <sVersionLogback>1.5.33</sVersionLogback>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>resources</directory>
                <excludes>
                    <exclude>log4j.xml</exclude>
                    <exclude>log4j.xml.j2</exclude>
                    <exclude>log4j2.xml</exclude>
                    <exclude>log4j2.xml.j2</exclude>
                    <exclude>config.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${sVersionFlattenMavenPlugin}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${sVersionMavenShadePlugin}</version>
                <configuration>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>META-INF/ECLIPSEF.RSA</exclude>
                                <exclude>META-INF/ECLIPSEF.SF</exclude>
                                <exclude>META-INF/eclipse.inf</exclude>
								<!-- Exclude the raw unmerged XmlPull service provider files -->
                    			<exclude>META-INF/services/org.xmlpull.v1.XmlPullParserFactory</exclude>                                
                            </excludes>
                        </filter>
                    </filters>                
                    <!-- Merges META-INF/services across all dependencies (SNAP, Logback, NetCDF, etc.) -->
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                            <resource>META-INF/services/org.xmlpull.v1.XmlPullParserFactory</resource>
                            <file>resources/META-INF/services/org.xmlpull.v1.XmlPullParserFactory</file>
                        </transformer>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${sVersionMavenJarPlugin}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>wasdi.LauncherMain</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Title>com.sun.media.imageio</Implementation-Title>
                            <Implementation-Version>1.0_01</Implementation-Version>
                            <Specification-Vendor>Sun Microsystems, Inc.</Specification-Vendor>
                            <Implementation-Vendor>Sun Microsystems, Inc.</Implementation-Vendor>
                            <Specification-Title>Java Advanced Imaging Image I/O Tools</Specification-Title>
                            <OpenIDE-Module-Specification-Version>unknown</OpenIDE-Module-Specification-Version>
                        </manifestEntries>                        
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Utilities & External Libraries -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${sVersionOkHttp}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${sVersionBcpkixJdk15on}</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>${sVersionCommonsCli}</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${sVersionJson}</version>
        </dependency>
        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
            <version>${sVersionSshj}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${sVersionLogback}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${sVersionLogback}</version>
            <scope>compile</scope>
        </dependency>

        <!-- SNAP & TOOLBOX KIT AGGREGATORS -->
        
        <!-- SNAP Core Engine Kit (Replaces individual snap-core, snap-bigtiff, snap-gdal-writer, etc.) -->
        <dependency>
            <groupId>org.esa.snap</groupId>
            <artifactId>snap-engine-kit</artifactId>
            <version>${sVersionSnap}</version>
            <type>pom</type>
        </dependency>

        <!-- Microwave Toolbox Kit (Replaces individual sar-op-*, microwavetbx-rcp, etc.) -->
        <dependency>
            <groupId>eu.esa.microwavetbx</groupId>
            <artifactId>microwavetbx-kit</artifactId>
            <version>${sVersionMicrowavetbx}</version>
            <exclusions>
                <!-- Retained your specific H2 exclusion to avoid class shadowing with Nitrite 4.x -->
                <exclusion>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Radarsat Toolbox Kit -->
        <dependency>
            <groupId>org.csa.rstb</groupId>
            <artifactId>rstb-kit</artifactId>
            <version>${sVersionMicrowavetbx}</version>
        </dependency>

        <!-- Optical Toolbox Kit (Replaces individual S2, S3, Landsat, MODIS, and Sentinel-3 readers) -->
        <dependency>
            <groupId>eu.esa.opt</groupId>
            <artifactId>opttbx-kit</artifactId>
            <version>${sVersionOpticaltbx}</version>
            <exclusions>
                <exclusion>
                    <groupId>javax.xml.parsers</groupId>
                    <artifactId>jaxp-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SMOS Toolbox Kit -->
        <dependency>
            <groupId>org.esa.smostbx</groupId>
            <artifactId>smos-kit</artifactId>
            <version>${sVersionSMOSTbx}</version>
        </dependency>
        
		<!-- Modern XmlPull Parser required by SNAP 14 / XStream -->
		<dependency>
		    <groupId>io.github.x-stream</groupId>
		    <artifactId>mxparser</artifactId>
		    <version>1.2.2</version>
		</dependency>        

        <!-- JLINDA -->
        <dependency>
            <groupId>org.jlinda</groupId>
            <artifactId>jlinda-nest</artifactId>
            <version>${sVersionMicrowavetbx}</version>
        </dependency>

        <!-- Additional Drivers & Testing -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${sVersionAssertjCore}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>edu.ucar</groupId>
            <artifactId>netcdfAll</artifactId>
            <version>${sVersionNetcdfAll}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${sVersionJunit}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.albfernandez</groupId>
            <artifactId>juniversalchardet</artifactId>
            <version>${sVersionJUniversalChardet}</version>
        </dependency>
        
        <!-- WASDI Shared Module -->
        <dependency>
            <groupId>fadeout.software.wasdi</groupId>
            <artifactId>wasdishared</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>snap-repo-public</id>
            <name>Public Maven Repository for SNAP</name>
            <url>https://nexus.snap-ci.ovh/repository/snap-maven-public/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
                <checksumPolicy>warn</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
                <checksumPolicy>warn</checksumPolicy>
            </snapshots>
        </repository>
        <repository>
            <id>wasdi-snap-build</id>
            <name>WASDI Local Repository for SNAP</name>
            <url>${sWasdiNexusRepositorySnapBuildUrl}</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
                <checksumPolicy>warn</checksumPolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
                <checksumPolicy>warn</checksumPolicy>
            </snapshots>
        </repository>
        <repository>
            <id>osgeo</id>
            <name>OSGeo Release Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
            <snapshots><enabled>false</enabled></snapshots>
            <releases><enabled>true</enabled></releases>
        </repository>
    </repositories>
</project>