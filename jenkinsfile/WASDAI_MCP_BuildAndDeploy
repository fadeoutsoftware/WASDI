pipeline {
  agent any

  environment {
    sCurrentRevision             = "${env.BUILD_ID}"
    sWasdiAIMCPImageName         = "wasdai-mcp"
    sWasdiAIMCPDockerPath        = "mcp_server"
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '3', daysToKeepStr: '365'))
    disableConcurrentBuilds()
  }

  stages {
    stage('DEBUG') {
      steps {
        echo "env.GIT_BRANCH                   = " + env.GIT_BRANCH
        echo "env.sAnsibleInventory            = " + env.sAnsibleInventory
        echo "env.sAnsibleLimit                = " + env.sAnsibleLimit
        echo "env.sCurrentRevision             = " + env.sCurrentRevision
        echo "env.sWasdiAIMCPImageName         = " + env.sWasdiAIMCPImageName
        echo "env.sWasdiAIMCPDockerPath        = " + env.sWasdiAIMCPDockerPath
        echo "env.WORKSPACE                    = " + env.WORKSPACE

        sh script: "pwd", label: "Current location"
        sh script: "docker --version", label: "Docker version"
      }
    }

    stage('CHECKOUT WASDAI CODE') {
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/wasdi-cloud/wasdai.git']]])
      }
    }

    stage('BUILD DOCKER IMAGE') {
      steps {
        sh script: """
          docker build \
            --tag ${env.sWasdiAIMCPImageName}:${env.sCurrentRevision} \
            --tag ${env.sWasdiAIMCPImageName}:latest \
            -f mcp_server/Dockerfile \
            .
        """,
        label: "Build Docker image for wasdi-mcp"
      }
    }

    stage('LOGIN TO NEXUS REGISTRIES') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'sWasdiNexusApplicationUser', usernameVariable: 'sWasdiNexusUsername', passwordVariable: 'sWasdiNexusPassword')
        ]) {
          sh script: """
            echo "${sWasdiNexusPassword}" | docker login -u "${sWasdiNexusUsername}" --password-stdin main01-registry-infrastructure.wasdi.net
            echo "${sWasdiNexusPassword}" | docker login -u "${sWasdiNexusUsername}" --password-stdin main02-registry-infrastructure.wasdi.net
          """,
          label: "Login to Nexus registries"
        }
      }
    }

    stage('TAG AND PUSH TO NEXUS - main01') {
      steps {
        sh script: """
          docker tag ${env.sWasdiAIMCPImageName}:${env.sCurrentRevision} main01-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:${env.sCurrentRevision}
          docker tag ${env.sWasdiAIMCPImageName}:latest main01-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:latest
          
          docker image push main01-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:${env.sCurrentRevision}
          docker image push main01-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:latest
        """,
        label: "Push image to main01 registry"
      }
    }

    stage('TAG AND PUSH TO NEXUS - main02') {
      steps {
        sh script: """
          docker tag ${env.sWasdiAIMCPImageName}:${env.sCurrentRevision} main02-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:${env.sCurrentRevision}
          docker tag ${env.sWasdiAIMCPImageName}:latest main02-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:latest
          
          docker image push main02-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:${env.sCurrentRevision}
          docker image push main02-registry-infrastructure.wasdi.net/${env.sWasdiAIMCPImageName}:latest
        """,
        label: "Push image to main02 registry"
      }
    }

    stage('UPDATE THE ANSIBLE VAULT PASSWORD') {
      steps {
        withCredentials([
          string(credentialsId: 'sWasdiAnsibleVaultFile', variable: 'sWasdiAnsibleVaultFile'),
          string(credentialsId: 'sWasdiAnsibleVaultPassword', variable: 'sWasdiAnsibleVaultPassword'),
        ]) {
          sh script: """
            mkdir --parents `dirname ${sWasdiAnsibleVaultFile}`
            echo '${sWasdiAnsibleVaultPassword}' > ${sWasdiAnsibleVaultFile}
          """,
          label: "Update the Ansible vault password"
        }
      }
    }

    stage('UPDATE THE ANSIBLE CODE') {
      steps {
        withCredentials([
          string(credentialsId: 'sWasdiAnsibleVaultFile', variable: 'sWasdiAnsibleVaultFile'),
          string(credentialsId: 'sWasdiAnsibleVaultPassword', variable: 'sWasdiAnsibleVaultPassword'),
        ]) {
          dir("${env.sWasdiAnsiblePath}") {
            checkout([$class: 'GitSCM', branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[credentialsId: 'sWasdiGitHubWasdiCloudSsh', url: "${env.sWasdiAnsibleGitRepositorySshUrl}"]]])
          }
        }
      }
    }

    stage('DEPLOY THE CONTAINER') {
      steps {
        withCredentials([
          string(credentialsId: 'sWasdiAnsibleVaultFile', variable: 'sWasdiAnsibleVaultFile'),
        ]) {
          sh script: """
            cd ${env.sWasdiAnsiblePath}
            ansible-playbook \
              playbooks/deployDockerContainer.yml \
              --inventory inventories/${env.sAnsibleInventory}.yml \
              --limit ${env.sAnsibleLimit} \
              --vault-password-file ${sWasdiAnsibleVaultFile} \
              --diff \
              --extra-vars 'sCurrentRevision=${env.sCurrentRevision} sDeployWasdiAIMCPContainer=true'
          """,
          label: "Deploy wasdi-mcp container via Ansible"
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
